{
  "name": "coopanion-guide-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "docs:dev": "pnpm --dir website dev",
    "docs:build": "pnpm --dir website build",
    "docs:preview": "pnpm --dir website preview",
    "docs:check": "pnpm --dir website check",
    "docs:check-links": "pnpm --dir website check:links",
    "docs:check-search": "pnpm --dir website check:search",
    "docs:verify": "pnpm docs:check && pnpm docs:build && pnpm docs:check-links && pnpm docs:check-search",
    "docs:cf-preview": "pnpm --dir website cf:preview",
    "docs:deploy": "pnpm --dir website deploy"
  }
}
